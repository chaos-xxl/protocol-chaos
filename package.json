{
  "name": "protocol-chaos-reference",
  "version": "0.2.0",
  "private": true,
  "description": "The Protocol Chaos specification, its conformance tests and a reference server",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "protocol-chaos-reference": "server/index.mjs"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "test": "npm run test:server && npm run test:conformance",
    "test:server": "node --test server/test/store.test.mjs",
    "test:conformance": "node conformance/run.mjs --stdio \"node server/index.mjs --owner-tools --data {tmp}\"",
    "conformance": "node conformance/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
